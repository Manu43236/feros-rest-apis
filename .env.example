# Copy this file to .env and fill in the values
# NEVER commit .env to git

# MySQL
DB_ROOT_PASSWORD=change_this_root_password
DB_NAME=feros_db
DB_USER=feros_user
DB_PASSWORD=change_this_db_password

# JWT - must be at least 256 bits (32+ characters), use a strong random string
JWT_SECRET=change_this_to_a_very_long_random_secret_string_minimum_32_chars
JWT_EXPIRATION=86400000
